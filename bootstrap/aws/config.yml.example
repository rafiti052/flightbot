# Copy to config.yml in your host data directory and replace placeholders.
# Never commit the filled config.yml (keep it only in FLIGHTBOT_HOST_DATA_DIR / the server volume).

schemaVersion: 1
schedule: "0 8,11,14,17,20,23 * * *"

anthropic:
  apiKey: "REPLACE_WITH_ANTHROPIC_API_KEY"

telegram:
  token: "REPLACE_WITH_TELEGRAM_BOT_TOKEN"
  chatId: "REPLACE_WITH_TELEGRAM_CHAT_ID"

routes:
  - name: "FLN → GIG"
    from: FLN
    to: GIG
    roundTrip: true
    departureDate: "2026-06-08"
    returnDate: "2026-06-12"
    flexDays: 0
    currency: BRL
    maxStops: 1
    maxBudget: 1500
    maxDurationHours: 5
    active: true
  - name: "FLN → SDU"
    from: FLN
    to: SDU
    roundTrip: true
    departureDate: "2026-06-08"
    returnDate: "2026-06-12"
    flexDays: 0
    currency: BRL
    maxStops: 1
    maxBudget: 1500
    maxDurationHours: 5
    active: true

_configMeta:
  revision: 0
  updatedAt: "2026-01-01T00:00:00.000Z"
