{
  "name": "flight-bot",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.10.0",
  "scripts": {
    "dev": "concurrently -n bot,web -c cyan,magenta \"./scripts/start-bot.sh\" \"pnpm --filter @flightbot/web dev\"",
    "start": "pnpm --filter @flightbot/bot start",
    "install-browsers": "pnpm --filter @flightbot/bot install-browsers",
    "dashboard:dev": "pnpm --filter @flightbot/web dev",
    "web:dev": "pnpm run dashboard:dev",
    "vercel:preview": "pnpm dlx vercel deploy --cwd apps/web --yes",
    "vercel:prod": "pnpm dlx vercel deploy --cwd apps/web --prod --yes"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
