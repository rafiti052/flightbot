# Shared example values for local development.
# Copy the relevant entries into bot.env.local, docker.env, or apps/web/.env.local.

# Bot runtime secrets
ANTHROPIC_API_KEY=replace-me
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-me

# Optional bot/admin settings
FLIGHTBOT_ADMIN_TOKEN=replace-me
FLIGHTBOT_WEB_URL=http://localhost:3001
FLIGHTBOT_LOG_MAX_BYTES=20971520
FLIGHTBOT_LOG_RETAIN_FILES=7
PORT=3000

# Dashboard placeholders
FLIGHTBOT_BOT_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=replace-me
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
ADMIN_ALLOWLIST=you@example.com

# Optional data directory overrides
# Local dev currently defaults to the repo root if FLIGHTBOT_DATA_DIR is unset.
FLIGHTBOT_DATA_DIR=/absolute/path/to/flightbot-data
FLIGHTBOT_HOST_DATA_DIR=./.flightbot/docker
